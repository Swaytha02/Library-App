<Dashboard::BookDetails @isIssued={{true}}>
    {{#each @books as |book|}}
    <tr>
        <td>{{book.id}}</td>
        <td>{{book.title}}</td>
        <td>{{book.author}}</td>
        <td>{{book.count}}</td>
        <td>
          {{#if book.issuedTo}}
            {{book.issuedTo}}
          {{else}}
            Not Assigned
          {{/if}}
        </td>
        <td>
            <div class="assign-student">
                <input
                    type="text"
                    placeholder="Student ID"
                    {{on "input" (fn this.updateStudentId book.id)}}
                />
                <button type="button" {{on "click" (fn this.assignBookToStudent book)}}>Assign</button>
            </div>
        </td>
    </tr>
    {{/each}}
</Dashboard::BookDetails>