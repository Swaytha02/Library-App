<Dashboard::BookDetails @isIssued={{true}}>
    {{#each @books as |book|}}
    <tr>
        <td>{{book.id}}</td>
        <td>{{book.title}}</td>
        <td>{{book.author}}</td>
        <td>{{book.count}}</td>
        <td>
          {{#if book.issuedTo}}
            {{book.issuedTo}}
          {{else}}
            Not Assigned
          {{/if}}
        </td>
    </tr>
    {{/each}}
</Dashboard::BookDetails>