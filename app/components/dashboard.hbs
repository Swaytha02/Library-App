<header class="dashboard-header">
    <h1>Library Dashboard</h1>
    <Profile />
</header>


<section class="dashboard-nav">
    <LinkTo class="dashboard-link" @route="dashboard.total-books">
        Total Books
    </LinkTo>
    <LinkTo class="dashboard-link" @route="dashboard.book-issued">
        Book Issued
    </LinkTo>
    <LinkTo class="dashboard-link" @route="dashboard.total-students">
        Total Students
    </LinkTo>
</section>

{{!-- Show overdue books only on the dashboard index --}}
{{#if (eq this.router.currentRoute.name "dashboard.index")}}
  <section class="overdue-section">
    <h2>Overdue Books</h2>

    {{#if this.overDueBooks.length}}
      <Dashboard::BookDetails>
        {{#each this.overDueBooks as |book|}}
          <tr>
            <td>{{book.id}}</td>
            <td>{{book.title}}</td>
            <td>{{book.author}}</td>
            <td>{{book.count}}</td>
          </tr>
        {{/each}}
      </Dashboard::BookDetails>
    {{else}}
      <p>No overdue books.</p>
    {{/if}}
  </section>
{{/if}}
